    "Spread the nodes apart; regions grow to keep them enclosed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spread the nodes apart; regions grow to keep them enclosed"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "باعِد بين العُقد؛ تتوسّع المناطق لتظل مُحيطةً بها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোডগুলো ছড়িয়ে দিন; সেগুলো ঘিরে রাখতে অঞ্চল বড় হয়"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knoten auseinanderziehen; Regionen wachsen mit, um sie zu umschließen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa los nodos; las regiones crecen para mantenerlos contenidos"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گره‌ها را از هم دور می‌کند؛ نواحی بزرگ می‌شوند تا آن‌ها را در بر بگیرند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écarter les nœuds ; les régions s'agrandissent pour les contenir"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פיזור הצמתים; האזורים גדלים כדי להכיל אותם"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोड्स को अलग फैलाएँ; उन्हें घेरे रखने के लिए क्षेत्र बढ़ते हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Renggangkan node; region membesar agar tetap melingkupinya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allontana i nodi; le regioni si espandono per contenerli"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノードを広げます。リージョンは内包を保つために拡大します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노드를 넓게 벌립니다. 영역은 노드를 감싸도록 함께 커집니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spreid de nodes uit; regio's groeien mee om ze te omsluiten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozsuwa węzły; regiony rosną, aby je obejmować"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Afasta os nós; as regiões crescem para mantê-los contidos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раздвигает узлы; регионы расширяются, чтобы вместить их"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düğümleri birbirinden ayırır; bölgeler onları kapsamak için büyür"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розсуньте вузли; регіони збільшуються, щоб їх охоплювати"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giãn các nút ra xa nhau; các vùng mở rộng để bao trọn chúng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拉开节点间距；区域会随之扩大以容纳节点"
          }
        }
      }
    },
    "This machine has no nested states to graph.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This machine has no nested states to graph."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحتوي هذه الآلة على حالات متداخلة لعرضها كمخطط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গ্রাফ করার মতো কোনো নেস্টেড স্টেট এই মেশিনে নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Maschine hat keine verschachtelten Zustände zum Darstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta máquina no tiene estados anidados para graficar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این ماشین هیچ حالت تودرتویی برای رسم گراف ندارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette machine n'a aucun état imbriqué à représenter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למכונה זו אין מצבים מקוננים לשרטוט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मशीन में ग्राफ़ बनाने के लिए कोई नेस्टेड स्टेट नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Machine ini tidak punya state bersarang untuk digambarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa macchina non ha stati annidati da rappresentare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このマシンにはグラフ化できるネストされた状態がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 머신에는 그래프로 표시할 중첩 상태가 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze machine heeft geen geneste states om te tekenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta maszyna nie ma zagnieżdżonych stanów do zobrazowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta máquina não tem estados aninhados para representar no grafo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этой машины нет вложенных состояний для отображения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu makinenin grafiği çizilecek iç içe durumu yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця машина не має вкладених станів для побудови графа."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy trạng thái này không có trạng thái lồng nhau để vẽ đồ thị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此状态机没有可绘制的嵌套状态。"
          }
        }
      }
    },
