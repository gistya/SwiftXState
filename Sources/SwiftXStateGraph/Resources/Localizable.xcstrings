    "3D rendering is not available on this platform.": {
      "comment": "Shown on platforms without SceneKit (e.g. watchOS) where the 3D view can't render.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3D rendering is not available on this platform."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التصيير ثلاثي الأبعاد غير متاح على هذه المنصة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই প্ল্যাটফর্মে থ্রিডি রেন্ডারিং উপলব্ধ নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3D-Rendering ist auf dieser Plattform nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El renderizado 3D no está disponible en esta plataforma."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رندر سه‌بعدی در این پلتفرم در دسترس نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rendu 3D n'est pas disponible sur cette plateforme."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עיבוד תלת-ממד אינו זמין בפלטפורמה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्लेटफ़ॉर्म पर 3D रेंडरिंग उपलब्ध नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendering 3D tidak tersedia di platform ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rendering 3D non è disponibile su questa piattaforma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプラットフォームでは3Dレンダリングを利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 플랫폼에서는 3D 렌더링을 사용할 수 없습니다."
          }
        },
