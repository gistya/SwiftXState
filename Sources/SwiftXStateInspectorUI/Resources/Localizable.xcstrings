    "Drive the machine to populate the event feed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل الآلة لتعبئة موجز الأحداث."
